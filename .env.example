# Kopē uz .env (lokāli) vai ieliec hostinga vides mainīgajos (Netlify:
# Site settings → Environment variables). Bez šiem vietne strādā, bet
# formas atver e-pasta programmu (mailto) un pasūtījumu sistēma ir izslēgta.

# Formu serveris — jebkurš URL, kas pieņem JSON POST (Formspree, Web3Forms,
# savs Cloudflare Worker). Ja hostings ir Netlify, tā vietā:
# VITE_NETLIFY_FORMS=true
VITE_FORM_ENDPOINT=
VITE_NETLIFY_FORMS=

# Konditorejas pasūtījumu sistēma ieslēdzas pati, kad ir formu serveris.
# Lai to turētu izslēgtu arī tad: VITE_ORDERING=off
VITE_ORDERING=

# Apmeklējumu uzskaite bez sīkdatnēm (plausible.io). Tukšs = nekā.
VITE_PLAUSIBLE_DOMAIN=
